#!/bin/sh
# list: one line per pipe, "DIR up" or "DIR down". Up means the hold still has the FIFO open.
for d in /tmp/icc-pipes-*/; do
  [ -d "$d" ] || continue
  d=${d%/}
  p=$(cat "$d/pid" 2>/dev/null)
  if [ "$(readlink "/proc/$p/fd/3" 2>/dev/null)" = "$d/0" ]; then s=up; else s=down; fi
  echo "$d $s"
done

#!/bin/bash
# .claude/skills/icc-pipes/scripts/remove
# remove DIR: drop the hold, delete the pipe. DIR is what create printed.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
d=${1:?usage: remove DIR}
[ -d "$d" ] && [ -p "$d/0" ] || { echo "not a pipe: $d" >&2; exit 1; }
# Kill the hold only when it is this pipe's: create opens lane 0 on fd 3,
# which is what list reads. A stranger's pid, or a recycled one, will not
# match, and a dead hold matches nothing.
p=$(cat "$d/pid" 2>/dev/null || :)
[ -n "$p" ] && [ "$(readlink "/proc/$p/fd/3" 2>/dev/null)" = "$d/0" ] &&
  kill "$p" 2>/dev/null || :
# The fifos and the pid file are what create made; take those and nothing
# else. rmdir refuses a directory with anything left in it, so a wrong
# path costs a fifo node, which holds no bytes, and never a file.
find "$d" -maxdepth 1 -type p -exec rm -f {} +
rm -f "$d/pid"
rmdir "$d"

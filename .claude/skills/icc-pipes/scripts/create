#!/bin/sh
# create [N]: make a fresh pipe of N lanes (even, default 2), hold every lane
# open, print its directory. Even lanes go one way, odd lanes the other.
set -eu
n=${1:-2}
[ "$n" -gt 0 ] && [ $((n % 2)) -eq 0 ] ||
  { echo "lanes must be even" >&2; exit 1; }
d=$(mktemp -d /tmp/icc-pipes-XXXXXXXX)
fds=; l=0
while [ "$l" -lt "$n" ]; do
  mkfifo "$d/$l"
  fds="$fds $((l + 3))<>'$d/$l'"
  l=$((l + 1))
done
eval "sleep infinity $fds </dev/null >/dev/null 2>&1 &"
echo $! > "$d/pid"
echo "$d"
